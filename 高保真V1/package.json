{
  "name": "chopchat-high-fi-v1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "typecheck:strict": "tsc -p tsconfig.app.json --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch --exactOptionalPropertyTypes --noUncheckedIndexedAccess",
    "lint": "npm run typecheck:strict",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots=all",
    "css:audit": "node scripts/css-audit.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.4"
  }
}
